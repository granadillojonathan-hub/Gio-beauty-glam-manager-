app.post('/subscribe', (req, res) => {
  const { email } = req.body;
  db.run("INSERT OR IGNORE INTO subscribers (email) VALUES (?)", [email], (err) => {
    if (err) return res.status(500).json({ error: 'Error al suscribir: ' + err.message });
    res.json({ message: 'Suscrito exitosamente' });
  });
});

// Análisis cabello con Vision
app.post('/analyze-hair', upload.single('photo'), async (req, res) => {
  try {
    const imagePath = req.file.path;
    const base64Image = fs.readFileSync(imagePath).toString('base64');
    const completion = await openai.chat.completions.create({
      model: "gpt-4o",
      messages: [
        {
          role: "user",
          content: [
            { type: "text", text: "Analiza esta foto de cabello y describe el tipo (e.g., liso, ondulado, rizado), porosidad (baja, media, alta), densidad (fina, media, gruesa), y color dominante. Proporciona un resumen claro y conciso." },
            { type: "image_url", image_url: { url: `data:image/jpeg;base64,${base64Image}`, detail: "high" } }
          ]
        }
      ],
      max_tokens: 300
    });
    fs.unlinkSync(imagePath); // Limpia upload temporal
    res.json({ analysis: completion.choices[0].message.content });
  } catch (error) {
    res.json({ analysis: 'Tipo: Liso, Porosidad: Media, Densidad: Alta (simulación)', error: error.message });
  }
});

